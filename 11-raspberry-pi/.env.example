# Either let the device talk to Silk directly (fine for hardware you fully control) …
RUMIK_API_KEY=rk_live_xxxxxxxxxxxxxxxxxxxxxxxx
RUMIK_AGENT_ID=ua_xxxxxxxx
SILK_BASE_URL=https://silk-api.rumik.ai
# … or point it at a token server and leave RUMIK_API_KEY empty (kiosks in public places).
TOKEN_URL=
# GPIO (BCM numbering)
BUTTON_PIN=17
LED_PIN=27
# ALSA device indexes from `python3 -c "import pyaudio; ..."` / `arecord -l`; blank = default
INPUT_DEVICE=
OUTPUT_DEVICE=
