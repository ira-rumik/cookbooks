# /etc/systemd/system/silk-agent.service
#
#   sudo cp systemd/silk-agent.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now silk-agent
#   journalctl -u silk-agent -f

[Unit]
Description=Silk voice agent (push-to-talk)
After=network-online.target sound.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/silk-agent
EnvironmentFile=/home/pi/silk-agent/.env
ExecStart=/home/pi/silk-agent/.venv/bin/python ptt_agent.py
Restart=always
RestartSec=3
# each restart is a new call; keep it from thrashing your concurrency slots if the network is down
StartLimitIntervalSec=60
StartLimitBurst=5

[Install]
WantedBy=multi-user.target
