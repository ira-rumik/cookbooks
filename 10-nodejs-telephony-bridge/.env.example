RUMIK_API_KEY=rk_live_xxxxxxxxxxxxxxxxxxxxxxxx
RUMIK_AGENT_ID=ua_xxxxxxxx
SILK_BASE_URL=https://silk-api.rumik.ai
PORT=3000
# Public hostname the carrier can reach (no scheme). With ngrok: abcd1234.ngrok-free.app
PUBLIC_HOST=
# Plivo: the format you want Plivo to stream. l16 @ 16 kHz is the best quality Plivo offers.
PLIVO_CONTENT_TYPE=audio/x-l16;rate=16000
# local-mic.js
MIC_RATE=16000
